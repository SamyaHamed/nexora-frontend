# Base URL of the Nexora REST API (no trailing slash), e.g. https://api.nexora.example
# Leave empty to use the built-in mock API (forms pretend to submit).
NEXT_PUBLIC_API_URL=

# Force the mock API even when NEXT_PUBLIC_API_URL is set.
NEXT_PUBLIC_USE_MOCK_API=false

# Mock-mode admin login for /dashboard (server-only, never NEXT_PUBLIC_).
# In development the defaults are admin@nexora.test / nexora-admin.
# Production builds in mock mode have no login unless both are set.
MOCK_ADMIN_EMAIL=admin@nexora.test
MOCK_ADMIN_PASSWORD=nexora-admin
